---
const { title = 'Zen Linz' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="site">
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.site {
    margin: 0;
    min-height: 100vh;
    background-image: url('/images/bg-2.jpg');
    background-repeat: repeat;
    font-family: "Open Sans", sans-serif;
    font-weight: 300;
    color: #000;
  }

  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    font-weight: 800;
  }

  h2 {
    font-weight: 600;
  }
</style>