---
import ContentPage from "../components/ContentPage.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const dynamicTextPageSlugs = new Set(["begleitung", "impressum", "leere-wolke", "links", "zendo-und-garten"]);
  const pages = await getCollection("pages");

  return pages
    .filter((page) => dynamicTextPageSlugs.has(page.id))
    .map((page) => ({
      params: { slug: page.id },
    }));
}

const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Missing slug parameter");
}
---

<ContentPage entryId={slug} />