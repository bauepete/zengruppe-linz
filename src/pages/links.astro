---
import BaseLayout from "../layouts/BaseLayout.astro";
import { assetPath } from "../utils/paths"
---

<BaseLayout title="Links">
  <main>
    <h1>Links</h1>

    <div class="centered-image">
      <a
        href="https://west-oestliche-weisheit.de/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={assetPath("/images/west-oestliche-weisheit-stiftung-logo.png")}
          alt="West-Östliche Weisheit Stiftung"
        />
      </a>
    </div>

    <div class="centered-image">
      <a
        href="https://www.benediktushof-holzkirchen.de/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={assetPath("/images/logo_benediktushof.png")}
          alt="Benediktushof"
        />
      </a>
    </div>

    <p class="prominent-link">
      <a href="https://www.alexanderporaj.de/">
        Alexander Poraj
      </a>
    </p>
  </main>
</BaseLayout>