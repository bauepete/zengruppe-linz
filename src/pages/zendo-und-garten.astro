---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Zendo und Garten">
  <main>
    <h1>Zendo und Garten</h1>

    <div class="centered-image">
      <img src="/public/images/garten1.jpg" alt="Garten" />
    </div>

    <div class="image-grid">
      <img src="/public/images/raum1.jpg" alt="Zendo" />
      <img src="/public/images/raum2.jpg" alt="Zendo" />
      <img src="/public/images/raum3.jpg" alt="Zendo" />
      <img src="/public/images/raum4.jpg" alt="Zendo" />
    </div>

    <div class="centered-image">
      <img src="/public/images/garten2.jpg" alt="Garten" />
    </div>
  </main>
</BaseLayout>