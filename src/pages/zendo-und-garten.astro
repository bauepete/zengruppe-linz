---
import BaseLayout from "../layouts/BaseLayout.astro";
import { assetPath } from "../utils/paths";
---

<BaseLayout title="Zendo und Garten">
  <main>
    <h1>Zendo und Garten</h1>

    <div class="centered-image">
      <img src={ assetPath("/images/garten1.jpg") } alt="Garten" />
    </div>

    <div class="image-grid">
      <img src={ assetPath("/images/raum1.jpg") } alt="Zendo" />
      <img src={ assetPath("/images/raum2.jpg") } alt="Zendo" />
      <img src={ assetPath("/images/raum3.jpg") } alt="Zendo" />
      <img src={ assetPath("/images/raum4.jpg") } alt="Zendo" />
    </div>)

    <div class="centered-image">
      <img src={ assetPath("/images/garten2.jpg") } alt="Garten" />
    </div>
  </main>
</BaseLayout>