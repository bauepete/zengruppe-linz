---
import { base, baseHref } from "../utils/paths";

const normalize = (path: string) => {
  const normalized = '/' + path.replace(/^\/+|\/+$/g, '');
  return normalized === '/' ? '/' : normalized;
};

const basePath = normalize(base);
const pathname = normalize(Astro.url.pathname);

// GitHub-Pages-Prefix entfernen:
// /zengruppe-linz/impressum -> /impressum
const currentPath =
  basePath !== '/' && pathname.startsWith(basePath)
    ? normalize(pathname.slice(basePath.length))
    : pathname;

const items = [
  { path: '/', label: 'Home' },
  { path: '/leere-wolke', label: 'Zen-Linie "Leere Wolke"' },
  { path: '/begleitung', label: 'Begleitung' },
  { path: '/zendo-und-garten', label: 'Zendo und Garten' },
  { path: '/links', label: 'Links' },
  { path: '/impressum', label: 'Impressum' },
];

const hrefFor = (path: string) =>
  path === '/'
    ? baseHref
    : `${baseHref}${path.slice(1)}/`;
---

<div class="header-content">
  <a class="site-title" href={baseHref}>Zen Linz</a>

  <nav class="navigation">
    {
      items.map(({ path, label }) => (
        <a
          href={hrefFor(path)}
          class={currentPath === path ? 'active' : ''}
        >
          {label}
        </a>
      ))
    }
  </nav>
</div>