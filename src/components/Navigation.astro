---
import { isActivePath, toPageHref } from "../utils/paths";

const items = [
  { path: '/', label: 'Home' },
  { path: '/leere-wolke', label: 'Zen-Linie "Leere Wolke"' },
  { path: '/begleitung', label: 'Begleitung' },
  { path: '/zendo-und-garten', label: 'Zendo und Garten' },
  { path: '/links', label: 'Links' },
  { path: '/impressum', label: 'Impressum' },
];
---

<div class="header-content">
  <a class="site-title" href={toPageHref('/')}>Zen Linz</a>

  <nav class="navigation">
    {
      items.map(({ path, label }) => (
        <a
          href={toPageHref(path)}
          class={isActivePath(Astro.url.pathname, path) ? 'active' : ''}
        >
          {label}
        </a>
      ))
    }
  </nav>
</div>