---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { assetPath, baseHref, pagePath } from "../utils/paths";

interface Props {
  entryId: string;
  notFoundMessage?: string;
}

const { entryId, notFoundMessage } = Astro.props as Props;

const pageById = await getEntry("pages", entryId);
const pages = pageById ? [] : await getCollection("pages");
const pageByFilename = pageById
  ? undefined
  : pages.find((entry) => entry.id === `${entryId}.md` || entry.id.endsWith(`/${entryId}.md`));

const page = pageById ?? pageByFilename;

if (!page) {
  throw new Error(notFoundMessage ?? `Page not found: ${entryId}`);
}

if (page.data.template !== "structured-narrative") {
  throw new Error(`Entry ${entryId} is not a structured-narrative page`);
}

const slugify = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-");

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\"/g, "&quot;")
    .replace(/'/g, "&#39;");

const sanitizeInlineHref = (href: string) => {
  const trimmedHref = href.trim();
  if (trimmedHref.length === 0 || trimmedHref.startsWith("//")) {
    return undefined;
  }

  const schemeMatch = trimmedHref.match(/^([a-z][a-z\d+.-]*):/i);
  if (schemeMatch) {
    return /^https?:/i.test(schemeMatch[0]) ? trimmedHref : undefined;
  }

  if (trimmedHref.startsWith("/") || trimmedHref.startsWith("#") || trimmedHref.startsWith("./") || trimmedHref.startsWith("../")) {
    return trimmedHref.startsWith("/") ? pagePath(trimmedHref) : trimmedHref;
  }

  const [targetPage, subsection] = trimmedHref.split("#", 2);
  if (/^[a-z0-9-]+$/i.test(targetPage)) {
    const pageHref = internalHref(targetPage);
    return subsection ? `${pageHref}#${subsection}` : pageHref;
  }

  return undefined;
};

// Markdown-capable fields support lightweight emphasis markup for editors.
const renderInlineMarkdown = (value: string) => {
  const linkReplacements: string[] = [];
  const withLinkTokens = value.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, text: string, href: string) => {
    const sanitizedHref = sanitizeInlineHref(href);
    if (!sanitizedHref) {
      return escapeHtml(text);
    }

    const isExternal = /^https?:\/\//i.test(sanitizedHref);
    const renderedLink = `<a href="${escapeHtml(sanitizedHref)}"${
      isExternal ? ' rel="noopener noreferrer" target="_blank"' : ""
    }>${escapeHtml(text)}</a>`;
    const token = `\u0000${linkReplacements.length}\u0000`;
    linkReplacements.push(renderedLink);
    return token;
  });

  const emphasized = escapeHtml(withLinkTokens)
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/_(.+?)_/g, "<em>$1</em>")
    .replace(/\r\n|\r|\n/g, "<br>");

  return emphasized.replace(/\u0000(\d+)\u0000/g, (_, idx: string) => {
    const index = Number(idx);
    return linkReplacements[index] ?? "";
  });
};

const internalHref = (targetPage: string) =>
  targetPage === "home" ? baseHref : pagePath(`/${targetPage}/`);

const resolveReferenceHref = (reference: {
  targetType: "internal-page" | "internal-subsection" | "external-url";
  page?: string;
  subsection?: string;
  url?: string;
}) => {
  if (reference.targetType === "external-url") {
    return reference.url ?? "#";
  }

  const pageHref = internalHref(reference.page ?? "home");
  if (reference.targetType === "internal-subsection") {
    return `${pageHref}#${reference.subsection ?? ""}`;
  }

  return pageHref;
};

const introHtml = page.data.introText ? renderInlineMarkdown(page.data.introText) : "";
const contentElements = page.data.content ?? [];
---

<BaseLayout title={page.data.title}>
  <article class="narrative-page">
    <h1>{page.data.title}</h1>

    {
      page.data.heroImage && (
        <p class="hero-image">
          <img src={assetPath(page.data.heroImage)} alt={page.data.heroImageAlt} />
        </p>
      )
    }

    {introHtml && <p class="intro-text" set:html={introHtml} />}

    {contentElements.map((element) => {
      if (element.type === "sectionTitle") {
        return <h2 id={slugify(element.text ?? "")}>{element.text}</h2>;
      }

      if (element.type === "subsectionTitle") {
        return <h3 id={slugify(element.text ?? "")}>{element.text}</h3>;
      }

      if (element.type === "paragraph") {
        return <p set:html={renderInlineMarkdown(element.text ?? "")} />;
      }

      if (element.type === "unorderedList") {
        return (
          <ul>
            {(element.items ?? []).map((item) => <li set:html={renderInlineMarkdown(item)} />)}
          </ul>
        );
      }

      if (element.type === "orderedList") {
        return (
          <ol>
            {(element.items ?? []).map((item) => <li set:html={renderInlineMarkdown(item)} />)}
          </ol>
        );
      }

      if (element.type === "quote") {
        return (
          <blockquote>
            <p set:html={renderInlineMarkdown(element.text ?? "")} />
            {element.author && <footer>{element.author}</footer>}
          </blockquote>
        );
      }

      return null;
    })}

    {
      (page.data.linkReferences?.length ?? 0) > 0 && (
        <section class="reference-links" aria-label="Weiterfuhrende Links">
          <ul>
            {page.data.linkReferences?.map((reference) => (
              <li>
                <a
                  href={resolveReferenceHref(reference)}
                  rel={reference.targetType === "external-url" ? "noopener noreferrer" : undefined}
                  target={reference.targetType === "external-url" ? "_blank" : undefined}
                >
                  {reference.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .narrative-page .hero-image {
    float: right;
    margin: 0 0 1rem 1.25rem;
    max-width: min(380px, 45%);
  }

  .narrative-page .hero-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .narrative-page .intro-text {
    font-weight: 600;
    margin-inline: 1rem;
  }

  .narrative-page h2,
  .narrative-page h3 {
    clear: both;
  }

  .narrative-page .reference-links {
    margin-top: 2rem;
  }

  @media (max-width: 760px) {
    .narrative-page .hero-image {
      float: none;
      margin: 0 auto 1rem;
      max-width: 100%;
    }
  }
</style>